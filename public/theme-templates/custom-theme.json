{
  "schema": "fpilot.theme.v1",
  "id": "my-theme",
  "name": "我的绿白主题",
  "description": "修改颜色和中英文字体后导入工作台",
  "base": "celadon",
  "appearance": "light",
  "colors": {
    "background": "#f4f5f6",
    "surface": "#ffffff",
    "surfaceRaised": "#f5f6f7",
    "sidebar": "#ffffff",
    "sidebarText": "#254b41",
    "sidebarMuted": "#53675d",
    "text": "#29333b",
    "mutedText": "#58636c",
    "border": "#dce1e5",
    "accent": "#19816b",
    "accentText": "#ffffff",
    "accentSoft": "#f2fcf7",
    "success": "#24714e",
    "successSoft": "#eaf7ee",
    "warning": "#8b5b16",
    "warningSoft": "#fff4df",
    "danger": "#b5414a",
    "dangerSoft": "#fcecef",
    "canvas": "#f5f6f7",
    "canvasGrid": "#dce1e5",
    "canvasEdge": "#82958e",
    "codeBackground": "#eef4f0",
    "codeText": "#304b3d",
    "plotText": "#53685f",
    "plotGrid": "#dce7e1"
  },
  "fonts": {
    "chinese": [
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "sans-serif"
    ],
    "english": [
      "Inter",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "sans-serif"
    ],
    "headingChinese": [
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "sans-serif"
    ],
    "headingEnglish": [
      "Inter",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "sans-serif"
    ],
    "monospace": [
      "SFMono-Regular",
      "Menlo",
      "Consolas",
      "monospace"
    ]
  },
  "metrics": {
    "fontSize": 16,
    "secondaryFontSize": 14,
    "radius": 4
  }
}
