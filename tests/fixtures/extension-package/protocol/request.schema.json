{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fpilot.extension-request.v2",
  "type": "object",
  "required": [
    "schema",
    "analysis_id",
    "inputs",
    "sources",
    "options",
    "output_dir",
    "result_file"
  ],
  "properties": {
    "schema": {
      "const": "fpilot.extension-request.v2"
    },
    "analysis_id": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "required": [
            "path",
            "name",
            "source_id",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object"
      }
    },
    "options": {
      "type": "object"
    },
    "output_dir": {
      "type": "string"
    },
    "result_file": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
