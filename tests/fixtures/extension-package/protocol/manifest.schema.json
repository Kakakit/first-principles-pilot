{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fpilot.extension.v2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "description",
    "entrypoint",
    "contexts",
    "stages",
    "sources",
    "inputs",
    "evidence",
    "execution",
    "dependencies",
    "options_schema",
    "ui_schema",
    "outputs",
    "fixtures"
  ],
  "properties": {
    "schema": {
      "const": "fpilot.extension.v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string"
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "structure",
          "attempt"
        ]
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "role",
          "title",
          "names",
          "max_bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "title": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "evidence": {
      "type": "array"
    },
    "execution": {
      "type": "object",
      "required": [
        "locations",
        "timeout_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "local",
              "ssh",
              "scheduler"
            ]
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "preferred_location": {
          "enum": [
            "local",
            "ssh",
            "scheduler"
          ],
          "default": "local"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      }
    },
    "options_schema": {
      "type": "object"
    },
    "ui_schema": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "table",
          "curve",
          "image",
          "file"
        ]
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "enum": [
            "source",
            "local"
          ],
          "default": "source"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
