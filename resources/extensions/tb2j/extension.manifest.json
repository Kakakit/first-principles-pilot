{
  "schema": "fpilot.extension.v2",
  "id": "tb2j",
  "name": "TB2J 交换参数与轨道分解",
  "version": "2.0.1",
  "description": "从完成的 Wannier 来源计算 J、SOC DMI/各向异性和可选轨道分解。在来源服务器直接执行 TB2J，原文件保留。",
  "entrypoint": "scripts/cli.py",
  "contexts": [
    "attempt"
  ],
  "stages": [
    "wannier90"
  ],
  "sources": {
    "min": 1,
    "max": 2
  },
  "inputs": [
    {
      "role": "wannier-input",
      "title": ".win 晶胞与基底",
      "names": [
        "wannier90.win",
        "wannier90.1.win",
        "wannier90.2.win"
      ],
      "max_bytes": 10485760
    },
    {
      "role": "wannier-output",
      "title": ".wout 完成记录",
      "names": [
        "wannier90.wout",
        "wannier90.1.wout",
        "wannier90.2.wout"
      ],
      "max_bytes": 10485760
    },
    {
      "role": "hamiltonian",
      "title": "Hamiltonian（hr + centres 或 tb）",
      "names": [
        "wannier90_hr.dat",
        "wannier90_tb.dat",
        "wannier90.1_hr.dat",
        "wannier90.1_tb.dat",
        "wannier90.2_hr.dat",
        "wannier90.2_tb.dat"
      ],
      "max_bytes": 1099511627776
    },
    {
      "role": "centres",
      "title": "Wannier 中心（hr 必需，tb 可选）",
      "names": [
        "wannier90_centres.xyz",
        "wannier90.1_centres.xyz",
        "wannier90.2_centres.xyz"
      ],
      "max_bytes": 10485760,
      "required": false
    }
  ],
  "evidence": [
    "COMPLETED",
    "wannier_all_done"
  ],
  "execution": {
    "locations": [
      "ssh",
      "local"
    ],
    "preferred_location": "ssh",
    "timeout_seconds": 86400
  },
  "dependencies": [
    "TB2J",
    "numpy",
    "ase"
  ],
  "options_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "title": "自旋模式",
        "enum": [
          "auto",
          "collinear",
          "spinor"
        ],
        "default": "auto",
        "description": "SOC：一个完成的 spinor attempt；共线：同父来源的 .1 上自旋和 .2 下自旋。"
      },
      "energy_source": {
        "type": "string",
        "title": "费米能来源",
        "enum": [
          "frozen",
          "manual"
        ],
        "default": "frozen",
        "description": "优先使用所选 Wannier attempt 冻结的 DFT 能量参考；缺少时选择 manual 并填写数值和来源。"
      },
      "efermi_ev": {
        "type": "number",
        "title": "手动费米能 E_F（eV，绝对能量）"
      },
      "energy_note": {
        "type": "string",
        "title": "手动能量参考来源说明",
        "maxLength": 2000
      },
      "magnetic_elements": {
        "type": "array",
        "title": "磁性元素",
        "items": {
          "type": "string",
          "pattern": "^[A-Z][a-z]?$"
        },
        "uniqueItems": true,
        "default": []
      },
      "magnetic_atoms": {
        "type": "array",
        "title": "磁性原子序号（从 1 开始）",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true,
        "default": [],
        "description": "元素与原子序号二选一；原子序号对应 .win 中原子顺序。"
      },
      "kmesh": {
        "type": "array",
        "title": "k 网格",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 3,
        "maxItems": 3,
        "default": [
          5,
          5,
          5
        ],
        "description": "官方默认用于起步，不是收敛推荐。"
      },
      "emin_ev": {
        "type": "number",
        "title": "积分下界 E−E_F（eV）",
        "default": -14,
        "description": "官方默认 -14 eV；需要独立检验积分区间。"
      },
      "emax_ev": {
        "type": "number",
        "title": "积分上界 E−E_F（eV）",
        "default": 0
      },
      "nz": {
        "type": "integer",
        "title": "积分点数",
        "minimum": 1,
        "default": 100,
        "description": "官方默认 100；不代表数值已收敛。"
      },
      "rcut_angstrom": {
        "type": "number",
        "title": "交换截断距离（Å，可留空）",
        "exclusiveMinimum": 0,
        "description": "留空沿用 TB2J 全部与 k 网格相容的 R。"
      },
      "nproc": {
        "type": "integer",
        "title": "TB2J 并行进程",
        "minimum": 1,
        "default": 1,
        "description": "服务器直接命令行运行，默认 1 个进程，无 PBS/Slurm 提交。"
      },
      "orb_decomposition": {
        "type": "boolean",
        "title": "输出轨道分解",
        "default": false
      },
      "groupby": {
        "type": "string",
        "title": "SOC 基底顺序（必须明确选择）",
        "enum": [
          "spin",
          "orbital"
        ],
        "description": "spin：所有 up 轨道后接所有 down；orbital：每个轨道的 up/down 相邻。"
      },
      "basis_confirmed": {
        "type": "boolean",
        "title": "已核对 SOC spinor 基底顺序",
        "default": false
      },
      "orbital_mapping": {
        "type": "array",
        "title": "可选轨道标签与分组映射",
        "default": [],
        "description": "轨道序号是该原子的 TB2J 轨道矩阵序号（从 1 开始）；不自动推断 dxy、t2g 或 eg。映射范围在读取实际矩阵时核验。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atom_index",
            "orbital_index",
            "label"
          ],
          "properties": {
            "atom_index": {
              "type": "integer",
              "title": "原子序号（1 起）",
              "minimum": 1
            },
            "orbital_index": {
              "type": "integer",
              "title": "原子内轨道矩阵序号（1 起）",
              "minimum": 1
            },
            "label": {
              "type": "string",
              "title": "用户确认标签",
              "minLength": 1,
              "maxLength": 80
            },
            "group": {
              "type": "string",
              "title": "可选分组",
              "maxLength": 80
            }
          }
        }
      },
      "description": {
        "type": "string",
        "title": "分析说明",
        "default": "TB2J exchange analysis",
        "maxLength": 2000
      }
    },
    "required": [
      "mode",
      "energy_source",
      "kmesh",
      "emin_ev",
      "emax_ev",
      "nz",
      "nproc",
      "orb_decomposition",
      "basis_confirmed",
      "orbital_mapping"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "energy_source": {
              "const": "manual"
            }
          },
          "required": [
            "energy_source"
          ]
        },
        "then": {
          "required": [
            "efermi_ev",
            "energy_note"
          ],
          "properties": {
            "energy_note": {
              "minLength": 1
            }
          }
        }
      }
    ]
  },
  "ui_schema": {
    "groupby": {
      "ui:placeholder": "选择并核对基底顺序"
    },
    "energy_note": {
      "ui:widget": "textarea"
    },
    "orbital_mapping": {
      "ui:options": {
        "orderable": false
      }
    },
    "magnetic_elements": {
      "ui:widget": "checkboxes",
      "ui:options": {
        "source_enum": "elements"
      }
    }
  },
  "outputs": [
    "table",
    "curve",
    "file"
  ],
  "fixtures": [
    "tests/fixtures/v2/spinor/wannier90.win",
    "tests/fixtures/v2/spinor/wannier90.wout",
    "tests/fixtures/v2/spinor/wannier90_tb.dat"
  ]
}
