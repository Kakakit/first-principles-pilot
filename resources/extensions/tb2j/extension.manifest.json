{
  "schema": "fpilot.extension.v2",
  "id": "tb2j",
  "name": "TB2J 交换参数与轨道分解",
  "version": "2.2.0",
  "description": "从完成的 Wannier 来源计算 J、SOC DMI/各向异性和可选轨道分解。在来源服务器直接执行 TB2J，原文件保留。",
  "entrypoint": "scripts/cli.py",
  "contexts": [
    "attempt"
  ],
  "stages": [
    "wannier90"
  ],
  "sources": {
    "min": 1,
    "max": 2
  },
  "inputs": [
    {
      "role": "wannier-input",
      "title": ".win 晶胞与基底",
      "names": [
        "wannier90.win",
        "wannier90.1.win",
        "wannier90.2.win"
      ],
      "max_bytes": 10485760
    },
    {
      "role": "wannier-output",
      "title": ".wout 完成记录",
      "names": [
        "wannier90.wout",
        "wannier90.1.wout",
        "wannier90.2.wout"
      ],
      "max_bytes": 10485760
    },
    {
      "role": "hamiltonian",
      "title": "Hamiltonian（hr + centres 或 tb）",
      "names": [
        "wannier90_hr.dat",
        "wannier90_tb.dat",
        "wannier90.1_hr.dat",
        "wannier90.1_tb.dat",
        "wannier90.2_hr.dat",
        "wannier90.2_tb.dat"
      ],
      "max_bytes": 1099511627776
    },
    {
      "role": "centres",
      "title": "Wannier 中心（hr 必需，tb 可选）",
      "names": [
        "wannier90_centres.xyz",
        "wannier90.1_centres.xyz",
        "wannier90.2_centres.xyz"
      ],
      "max_bytes": 10485760,
      "required": false
    }
  ],
  "evidence": [
    "COMPLETED",
    "wannier_all_done"
  ],
  "execution": {
    "locations": [
      "ssh",
      "local"
    ],
    "preferred_location": "ssh",
    "timeout_seconds": 86400
  },
  "dependencies": [
    "TB2J",
    "numpy",
    "ase"
  ],
  "options_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "title": "自旋模式",
        "default": "auto",
        "description": "SOC：一个完成的 spinor attempt；共线：同父来源的 .1 上自旋和 .2 下自旋。",
        "oneOf": [
          {
            "const": "auto",
            "title": "自动识别来源"
          },
          {
            "const": "collinear",
            "title": "共线 · 上/下自旋双通道"
          },
          {
            "const": "spinor",
            "title": "SOC · spinor 单通道"
          }
        ]
      },
      "energy_source": {
        "type": "string",
        "title": "费米能来源",
        "default": "frozen",
        "description": "优先使用所选 Wannier attempt 冻结的 DFT 能量参考；缺少时选择 manual 并填写数值和来源。",
        "oneOf": [
          {
            "const": "frozen",
            "title": "使用来源冻结的费米能（默认）"
          },
          {
            "const": "manual",
            "title": "手动填写费米能与来源"
          }
        ]
      },
      "efermi_ev": {
        "type": "number",
        "title": "手动费米能 E_F（eV，绝对能量）",
        "description": "仅在手动能量参考时填写：与本次 Hamiltonian 相同能量零点下的绝对费米能，单位 eV；不能直接填相对能量 0。"
      },
      "energy_note": {
        "type": "string",
        "title": "手动能量参考来源说明",
        "maxLength": 2000,
        "description": "说明手动费米能取自哪次计算、哪个文件；自动冻结参考可用时无需填写。"
      },
      "magnetic_elements": {
        "type": "array",
        "title": "磁性元素",
        "items": {
          "type": "string",
          "pattern": "^[A-Z][a-z]?$"
        },
        "uniqueItems": true,
        "default": [],
        "description": "选择参与交换作用的元素，例如 Cr 和 Fe；将包含这些元素的全部原子。氧等配体仍保留在 Wannier 模型中，不必仅为保留配体而勾选它。"
      },
      "magnetic_atoms": {
        "type": "array",
        "title": "磁性原子序号（从 1 开始）",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true,
        "default": [],
        "description": "元素与原子序号二选一；原子序号对应 .win 中原子顺序。"
      },
      "kmesh": {
        "type": "array",
        "title": "k 网格",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 3,
        "maxItems": 3,
        "default": [
          5,
          5,
          5
        ],
        "description": "TB2J 在布里渊区积分的三个方向网格，不会重做 DFT/Wannier。更密通常更耗时，并扩大可表示的平移范围；默认 5×5×5 仅作起步，不能证明收敛。"
      },
      "emin_ev": {
        "type": "number",
        "title": "积分下界 E−E_F（eV）",
        "default": -14,
        "description": "能量积分从 E_F 加此值开始，单位 eV。默认 −14；应覆盖与磁性交换有关的低能态。改变它会改变结果，需检查收敛。"
      },
      "emax_ev": {
        "type": "number",
        "title": "积分上界 E−E_F（eV）",
        "default": 0,
        "description": "能量积分到 E_F 加此值结束，单位 eV。默认 0 对应费米能；正值包含费米能以上的能量，需有明确研究用途，不是单纯提高精度。"
      },
      "nz": {
        "type": "integer",
        "title": "积分点数",
        "minimum": 1,
        "default": 100,
        "description": "能量积分的数值采样点数，默认 100。增大通常提高积分分辨率并增加耗时；需比较不同点数的 J 判断收敛。"
      },
      "rcut_angstrom": {
        "type": "number",
        "title": "最大原子间距离（Å）",
        "exclusiveMinimum": 0,
        "description": "只计算 d 小于此数值的原子对。例如 9 表示 d < 9 Å；不是晶格平移 R 的整数大小。缩小范围会减少交换项；k 网格仍限制可覆盖范围。历史结果页可直接筛选距离，无需重算。",
        "default": 9
      },
      "nproc": {
        "type": "integer",
        "title": "TB2J 并行进程",
        "minimum": 1,
        "default": 1,
        "description": "同一服务器上的 TB2J 进程数，默认 1；并非调度器申请核数。不会提交 PBS/Slurm，也不会因为修改显示选项启动计算。"
      },
      "orb_decomposition": {
        "type": "boolean",
        "title": "输出轨道分解",
        "default": false,
        "description": "同时保存每条交换作用的轨道贡献矩阵，便于点选查看热图；会增加结果体积。轨道标签自动读取已有投影，代表初始投影参考，不保证最终 WF 为纯原子轨道。"
      },
      "groupby": {
        "type": "string",
        "title": "SOC 基底顺序（必须明确选择）",
        "description": "spin：所有 up 轨道后接所有 down；orbital：每个轨道的 up/down 相邻。",
        "oneOf": [
          {
            "const": "spin",
            "title": "按自旋：全部 up 后接全部 down"
          },
          {
            "const": "orbital",
            "title": "按轨道：各轨道 up/down 相邻"
          }
        ]
      },
      "basis_confirmed": {
        "type": "boolean",
        "title": "已核对 SOC spinor 基底顺序",
        "default": false,
        "description": "仅 SOC 需要；基底顺序影响 spinor Hamiltonian 的解释，不能由轨道数量猜测。共线计算无需确认。"
      },
      "orbital_mapping": {
        "type": "array",
        "title": "可选轨道标签与分组映射",
        "default": [],
        "description": "高级、可选。通常无需填写：结果页会自动显示有文件证据的初始投影名称。仅在确实知道实际基底含义时覆盖标签，不会重算或改变 J。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atom_index",
            "orbital_index",
            "label"
          ],
          "properties": {
            "atom_index": {
              "type": "integer",
              "title": "原子序号（1 起）",
              "minimum": 1
            },
            "orbital_index": {
              "type": "integer",
              "title": "原子内轨道矩阵序号（1 起）",
              "minimum": 1
            },
            "label": {
              "type": "string",
              "title": "用户确认标签",
              "minLength": 1,
              "maxLength": 80
            },
            "group": {
              "type": "string",
              "title": "可选分组",
              "maxLength": 80
            }
          }
        }
      },
      "description": {
        "type": "string",
        "title": "分析说明",
        "default": "TB2J exchange analysis",
        "maxLength": 2000,
        "description": "可选备注，用于区分参数与用途；不影响 J 的数值。"
      }
    },
    "required": [
      "mode",
      "energy_source",
      "kmesh",
      "emin_ev",
      "emax_ev",
      "nz",
      "nproc",
      "orb_decomposition",
      "basis_confirmed",
      "orbital_mapping"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "energy_source": {
              "const": "manual"
            }
          },
          "required": [
            "energy_source"
          ]
        },
        "then": {
          "required": [
            "efermi_ev",
            "energy_note"
          ],
          "properties": {
            "energy_note": {
              "minLength": 1
            }
          }
        }
      }
    ]
  },
  "ui_schema": {
    "groupby": {
      "ui:placeholder": "选择并核对基底顺序"
    },
    "energy_note": {
      "ui:widget": "textarea"
    },
    "orbital_mapping": {
      "ui:options": {
        "orderable": false,
        "addable": true
      }
    },
    "magnetic_elements": {
      "ui:widget": "checkboxes",
      "ui:options": {
        "source_enum": "elements"
      }
    },
    "kmesh": {
      "ui:options": {
        "orderable": false,
        "addable": false,
        "removable": false
      }
    },
    "ui:groups": [
      {
        "title": "常用参数",
        "fields": [
          "magnetic_elements",
          "rcut_angstrom",
          "kmesh",
          "orb_decomposition"
        ]
      },
      {
        "title": "高级参数与来源解释",
        "collapsed": true,
        "fields": [
          "mode",
          "energy_source",
          "efermi_ev",
          "energy_note",
          "magnetic_atoms",
          "emin_ev",
          "emax_ev",
          "nz",
          "nproc",
          "groupby",
          "basis_confirmed",
          "orbital_mapping",
          "description"
        ]
      }
    ],
    "ui:visibility": {
      "groupby": {
        "field": "mode",
        "equals": "spinor",
        "source_spinors": true
      },
      "basis_confirmed": {
        "field": "mode",
        "equals": "spinor",
        "source_spinors": true
      },
      "efermi_ev": {
        "field": "energy_source",
        "equals": "manual"
      },
      "energy_note": {
        "field": "energy_source",
        "equals": "manual"
      },
      "orbital_mapping": {
        "field": "orb_decomposition",
        "equals": true
      }
    },
    "ui:preview": [
      "rcut_angstrom",
      "magnetic_elements",
      "kmesh",
      "emin_ev",
      "emax_ev",
      "nz",
      "orb_decomposition"
    ]
  },
  "outputs": [
    "table",
    "curve",
    "file"
  ],
  "fixtures": [
    "tests/fixtures/v2/spinor/wannier90.win",
    "tests/fixtures/v2/spinor/wannier90.wout",
    "tests/fixtures/v2/spinor/wannier90_tb.dat"
  ],
  "presentation": {
    "entrypoint": "scripts/presentation.py",
    "location": "local",
    "inputs": [
      {
        "path": "exchange.csv",
        "required": true
      },
      {
        "path": "orbitals.csv",
        "required": false
      },
      {
        "path": "command.json",
        "required": true
      },
      {
        "path": "result.json",
        "required": true
      },
      {
        "path": "TB2J_results/assigned_basis.txt",
        "required": false
      },
      {
        "path": "model/up.win",
        "required": false
      },
      {
        "path": "model/down.win",
        "required": false
      },
      {
        "path": "model/spinor.win",
        "required": false
      },
      {
        "path": "model/up_centres.xyz",
        "required": false
      },
      {
        "path": "model/down_centres.xyz",
        "required": false
      },
      {
        "path": "model/spinor_centres.xyz",
        "required": false
      }
    ]
  }
}
