{
  "schema": "fpilot.extension.v2",
  "id": "crystal-structure-distortion-analysis",
  "name": "配位多面体畸变",
  "version": "2.2.0",
  "description": "填写 CrO6, FeO4，逐位点查看三维多面体、键长、内部角、共享配体桥角和中文指标公式。",
  "entrypoint": "scripts/cli.py",
  "contexts": [
    "structure",
    "attempt"
  ],
  "stages": [],
  "sources": {
    "min": 1,
    "max": 1
  },
  "inputs": [
    {
      "role": "structure",
      "title": "结构",
      "names": [
        "CONTCAR",
        "POSCAR"
      ],
      "max_bytes": 10485760
    }
  ],
  "evidence": [],
  "execution": {
    "locations": [
      "local",
      "ssh"
    ],
    "timeout_seconds": 300,
    "preferred_location": "local"
  },
  "dependencies": [
    "numpy",
    "scipy.spatial"
  ],
  "options_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "polyhedra": {
        "type": "string",
        "title": "多面体类型",
        "description": "例如 CrO6, FeO4：Cr 为中心、O 为配体、6 为配位数。可用中文逗号，一次填写多种类型；不填写化学式系数或氧化态。",
        "minLength": 1
      },
      "search_radius_angstrom": {
        "type": "number",
        "title": "搜索半径 / Å",
        "exclusiveMinimum": 0,
        "maximum": 20,
        "default": 3,
        "description": "寻找配体候选的最大距离，单位 Å，默认 3。不是自动识别化学键；邻居不足时可在确认物理配位后增大。"
      },
      "center_element": {
        "type": "string",
        "title": "中心元素",
        "pattern": "^[A-Z][a-z]?$"
      },
      "ligand_element": {
        "type": "string",
        "title": "配体元素",
        "pattern": "^[A-Z][a-z]?$"
      },
      "coordination": {
        "type": "integer",
        "title": "配位数",
        "enum": [
          4,
          6
        ]
      },
      "polyhedron_types": {
        "type": "array",
        "title": "多面体类型（每个输入框一种）",
        "description": "点击添加，一框填写 CrO6，另一框填写 FeO4。程序按中心元素选择原子，并寻找对应配体；只支持单一配体的四配位、六配位。",
        "maxItems": 16,
        "default": [],
        "items": {
          "type": "string",
          "title": "多面体",
          "default": ""
        }
      }
    }
  },
  "ui_schema": {
    "ui:groups": [
      {
        "title": "分析对象",
        "fields": [
          "polyhedron_types"
        ]
      },
      {
        "title": "高级设置",
        "fields": [
          "search_radius_angstrom"
        ],
        "collapsed": true
      }
    ],
    "ui:preview": [
      "polyhedron_types",
      "search_radius_angstrom"
    ],
    "polyhedra": {
      "ui:widget": "hidden"
    },
    "center_element": {
      "ui:widget": "hidden"
    },
    "ligand_element": {
      "ui:widget": "hidden"
    },
    "coordination": {
      "ui:widget": "hidden"
    },
    "polyhedron_types": {
      "items": {
        "ui:placeholder": "例如 CrO6（每框一种）"
      },
      "ui:options": {
        "orderable": false
      }
    }
  },
  "outputs": [
    "table",
    "file"
  ],
  "fixtures": [
    "fixtures/POSCAR"
  ],
  "presentation": {
    "entrypoint": "scripts/presentation.py"
  }
}
